{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.4",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-haptics": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-location": "~57.0.10",
    "expo-notifications": "~57.0.11",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:ios": "expo export --platform ios --output-dir dist/ios-preview",
    "validate": "npm run typecheck && npm run test && npm run export:ios",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios:dev": "npx eas-cli@latest build --platform ios --profile development",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production"
  },
  "private": true
}
