{
  "expo": {
    "name": "接單雷達",
    "slug": "order-radar-tw",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-rgb.png",
    "scheme": "orderradar",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07110d",
    "ios": {
      "bundleIdentifier": "com.baka0406.orderradar",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "接單雷達使用定位顯示附近公開設備；若你另行加入匿名資料計畫，記錄訂單時會先在手機轉成約 2 公里區域再送出。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "只有你主動啟用背景安全提醒時，接單雷達才會在背景使用定位；位置只在手機上比對，不會儲存行程。"
      }
    },
    "android": {
      "package": "com.baka0406.orderradar",
      "adaptiveIcon": {
        "backgroundColor": "#07110d",
        "foregroundImage": "./assets/app-icon-rgb.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "接單雷達使用定位顯示附近公開設備；若你另行加入匿名資料計畫，記錄訂單時會先在手機轉成約 2 公里區域再送出。",
          "locationAlwaysAndWhenInUsePermission": "只有你主動啟用背景安全提醒時，接單雷達才會在背景使用定位；位置只在手機上比對，不會儲存行程。",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07110d",
          "image": "./assets/app-icon-rgb.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a263b478-19e4-4460-8121-7642de811bae"
      }
    },
    "owner": "baka9881"
  }
}
